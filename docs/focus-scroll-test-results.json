    "commands": [
      "profile=$(mktemp -d /tmp/afterwave-no-cjk.XXXXXX)",
      "mkdir -p \"$profile/font\" \"$profile/cache\"",
      "ln -s /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf \"$profile/font/DejaVuSans.ttf\"",
      "ln -s /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf \"$profile/font/DejaVuSans-Bold.ttf\"",
      "printf '<?xml version=\"1.0\"?><!DOCTYPE fontconfig SYSTEM \"fonts.dtd\"><fontconfig><dir>%s/font</dir><cachedir>%s/cache</cachedir><config></config></fontconfig>\\n' \"$profile\" \"$profile\" > \"$profile/fonts.conf\"",
      "FONTCONFIG_FILE=\"$profile/fonts.conf\" fc-match sans-serif",
      "FONTCONFIG_FILE=\"$profile/fonts.conf\" fc-list :lang=zh",
      "FONTCONFIG_FILE=\"$profile/fonts.conf\" node scripts/local-crisis-visuals-test.mjs",
      "FONTCONFIG_FILE=\"$profile/fonts.conf\" AFTERWAVE_TALLY_ASSET_DELAY_MS=180 node scripts/local-crisis-visuals-test.mjs"
    ],
